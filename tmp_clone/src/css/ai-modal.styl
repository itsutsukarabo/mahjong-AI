.controller button.ai-analyze
  background #3a3a5c
  border 1px solid #556
  color #aaf
  padding 3px 10px
  border-radius 4px
  cursor pointer
  font-size 11px
  font-family menu-font
  vertical-align middle
  margin-left 4px
  &:hover
    background #4a4a7c
    color white

.ai-modal
  display none
  position fixed
  width 430px
  background #222
  border 1px solid #666
  border-radius 8px
  overflow hidden
  flex-direction column
  color white
  font-family menu-font
  font-size 12px
  z-index 100
  box-shadow -4px 0 16px rgba(0,0,0,0.7)

  &:not(.hide)
    display flex

  .ai-modal-header
    display flex
    align-items center
    justify-content space-between
    padding 10px 16px
    background #333
    border-bottom 1px solid #555
    flex-shrink 0

  .ai-modal-title
    font-size 15px
    font-weight bold

  .ai-modal-close
    background none
    border none
    color #ccc
    font-size 20px
    cursor pointer
    padding 0 4px
    line-height 1
    &:hover
      color white

  .ai-modal-loading
    padding 16px
    color #aaa
    flex-shrink 0

  .ai-modal-body
    overflow-y auto
    padding 12px
    flex 1

  .ai-tab-nav
    display flex
    gap 4px
    margin-bottom 10px

  .ai-tab-btn
    background #444
    border none
    color #ccc
    padding 5px 14px
    border-radius 4px
    cursor pointer
    font-size 12px
    font-family menu-font
    &.active
      background #666
      color white
    &:hover:not(.active)
      background #555

  .ai-tab-pane
    margin-bottom 10px
    &.hide
      display none

  .ai-candidate-table
    border-collapse collapse
    width 100%
    font-size 12px
    th, td
      padding 4px 8px
      text-align left
      border-bottom 1px solid #3a3a3a
    th
      color #999
      font-weight normal
    tr.ai-selected
      background #4a4a4a
    .ai-cand-tile
      white-space nowrap
      img
        vertical-align middle
      span
        margin-left 4px
    .ai-xiangting
      white-space nowrap
      color #ccc
    .ai-ev
      text-align right
      font-family monospace
      white-space nowrap
      &.ai-ev-high
        color #f44
      &.ai-ev-middle
        color #fa4
      &.ai-ev-low
        color #ff4
      &.ai-ev-none
        color #777
    .ai-tingpai
      white-space nowrap
      img
        vertical-align middle
      span
        margin-left 4px
        color #999
    .ai-weixian
      text-align right
      font-family monospace
      color #999

  .ai-feature-panel
    margin-top 8px
    border-top 1px solid #3a3a3a
    padding-top 8px
    summary
      cursor pointer
      color #888
      font-size 11px
      padding 2px 0
      &:hover
        color #aaa
    .ai-feature-inner
      margin-top 10px
    .ai-feature-section
      margin-bottom 14px
      h4
        font-size 11px
        color #888
        margin 0 0 6px

  .ai-paishu-table,
  .ai-paijia-table
    border-collapse collapse
    font-size 11px
    th, td
      padding 2px 7px
      text-align center
      border 1px solid #3a3a3a
      min-width 22px
    th
      background #2a2a2a
      color #888
    .ai-suit-m th
      color #e87
    .ai-suit-p th
      color #88e
    .ai-suit-s th
      color #8e8
    .ai-suit-z th
      color #ee8
    .ai-zero
      color #555

  .ai-phase2-slots
    margin-top 10px
    border-top 1px solid #3a3a3a
    padding-top 8px

    .ai-phase2-header
      font-size 10px
      color #666
      margin-bottom 6px

    .ai-p2-section
      margin-bottom 8px

    .ai-p2-label
      font-size 11px
      color #888
      margin-bottom 3px

    // 打牌予測テーブル
    .ai-p2-table
      border-collapse collapse
      width 100%
      font-size 12px
      td
        padding 2px 4px
        vertical-align middle
      .ai-p2-tile
        width 32px
        img
          vertical-align middle
      .ai-p2-bar
        width 100%

    .ai-prob-wrap
      display flex
      align-items center
      gap 6px
      height 14px
      .ai-prob-fill
        height 10px
        background #4a8a4a
        border-radius 2px
        min-width 2px
      span
        font-size 11px
        color #aaa
        white-space nowrap
        font-family monospace

    // 局面評価
    .ai-vf-body
      .ai-vf-row
        display inline-block
        margin-right 16px
        font-size 12px
        b
          font-family monospace
          margin-left 4px
        .ai-pos
          color #6e6
        .ai-neg
          color #e66

    // 他家手牌推定
    .ai-hi-player-section
      margin-bottom 12px
      .ai-hi-player-label
        font-size 11px
        color #888
        margin-bottom 4px

    .ai-hi-table
      border-collapse collapse
      font-size 8px
      th, td
        padding 1px 2px
        border 1px solid #3a3a3a
        min-width 42px
        vertical-align top
        text-align center
      th
        background #2a2a2a
        color #888
        min-width auto
        padding 2px 5px
        white-space nowrap
      .ai-suit-m th
        color #e87
      .ai-suit-p th
        color #88e
      .ai-suit-s th
        color #8e8
      .ai-suit-z th
        color #ee8

    .ai-hi-probs
      line-height 1.5
      font-family monospace
      text-align left
      .ai-hi-p0
        color #555
      .ai-hi-p1
        color #aaa
      .ai-hi-p2
        color #fa4
      .ai-hi-p3
        color #f84
      .ai-hi-p4
        color #f44

    .ai-hi-aka-th
      color #f66
      background #2a1a1a

    .ai-hi-aka-td
      background #1e1212
      text-align center
      .ai-hi-aka-prob
        font-family monospace
        color #f66
        font-size 9px
      &.ai-hi-aka-na
        color #555
        font-size 9px

    // ブロック期待値セクション
    .ai-hi-block-section
      margin-top 8px
      border-top 1px solid #3a3a3a
      padding-top 6px

      .ai-hi-block-label
        font-size 10px
        color #888
        margin-bottom 4px

      .ai-hi-block-table
        font-size 8px
        margin-bottom 6px
        th, td
          min-width 44px
        .ai-hi-block-empty
          background none
          border none

      .ai-hi-probs
        .ai-hi-b0
          color #555
        .ai-hi-b1
          color #fa4
        .ai-hi-b2
          color #f84
        .ai-hi-b3
          color #f44

      .ai-hi-best-hand
        margin-top 4px
        font-size 10px
        .ai-hi-shanten-label
          color #888
        .ai-hi-tenpai-prob
          margin-left 6px
          font-family monospace
          color #8af
          font-size 10px
        .ai-hi-decomp
          font-family monospace
          color #aaa
          margin-top 1px
        .ai-hi-hand-str
          font-family monospace
          color #aaa

    .ai-p2-na
      font-size 11px
      color #555
